rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.enabled == true;
    }
    function nameOK(name) {
      return name is string && name.size() >= 2 && name.size() <= 24
        && name.matches('[A-Za-z0-9][A-Za-z0-9 _.-]{1,23}') && !name.matches('.* ');
    }
    function creditOK(c) {
      return c is map && c.keys().hasOnly(['displayName', 'submissionId']) && c.keys().hasAll(['displayName'])
        && nameOK(c.displayName) && (!('submissionId' in c) || (c.submissionId is string && c.submissionId.matches('[A-Za-z0-9_-]{1,128}')));
    }
    function creditsOK(c) {
      return c is map && c.keys().hasOnly(['player', 'ladder', 'cross', 'grid', 'drill'])
        && (!('grid' in c) || creditOK(c.grid)) && (!('drill' in c) || creditOK(c.drill))
        && (!('player' in c) || creditOK(c.player)) && (!('ladder' in c) || creditOK(c.ladder)) && (!('cross' in c) || creditOK(c.cross));
    }
    function validPuzzle(date, league) {
      let p = request.resource.data;
      return p.keys().hasOnly(['date', 'puzzle', 'published', 'unlockAt', 'updatedAt', 'updatedBy', 'revision', 'credits'])
        && p.keys().hasAll(['date', 'puzzle', 'published', 'unlockAt', 'updatedAt', 'updatedBy', 'revision'])
        && date.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && p.date == date && p.puzzle is map && p.puzzle.date == date
        && p.puzzle.schemaVersion == 1 && p.puzzle.get('league', 'general') == league
        && (league == 'general' || (league in ['nfl', 'mlb', 'nba', 'ncaaf'] && !p.puzzle.keys().hasAny(['gridIron', 'twoMinuteDrill'])))
        && (!('gridIron' in p.puzzle) || p.puzzle.gridIron is map)
        && (!('twoMinuteDrill' in p.puzzle) || p.puzzle.twoMinuteDrill is map)
        && p.puzzle.keys().hasAny(['playerGuess', 'statLadder', 'crossSport', 'gridIron', 'twoMinuteDrill'])
        && (!('playerGuess' in p.puzzle) || p.puzzle.playerGuess is map)
        && (!('statLadder' in p.puzzle) || p.puzzle.statLadder is map)
        && (!('crossSport' in p.puzzle) || p.puzzle.crossSport is map)
        && (!p.published || (p.puzzle.playerGuess is map && p.puzzle.statLadder is map && p.puzzle.crossSport is map))
        && (!('credits' in p) || creditsOK(p.credits))
        && p.published is bool && p.unlockAt is timestamp
        && p.updatedAt == request.time && p.updatedBy == request.auth.uid
        && p.revision is int && p.revision > 0;
    }
    function released(date, league) {
      let path = league == 'general' ? /databases/$(database)/documents/dailyPuzzles/$(date) : /databases/$(database)/documents/leaguePuzzles/$(league)/days/$(date);
      return exists(path) && get(path).data.published == true && get(path).data.unlockAt <= request.time;
    }
    function validResult(id) {
      let r = request.resource.data;
      let league = r.get('league', 'general');
      let path = league == 'general' ? /databases/$(database)/documents/dailyPuzzles/$(r.date) : /databases/$(database)/documents/leaguePuzzles/$(league)/days/$(r.date);
      let field = r.game == 'player' ? 'playerGuess' : r.game == 'ladder' ? 'statLadder' : r.game == 'cross' ? 'crossSport' : r.game == 'grid' ? 'gridIron' : 'twoMinuteDrill';
      return request.auth != null
        && r.keys().hasOnly(['playerId', 'date', 'league', 'game', 'score', 'won', 'checks', 'reveals', 'completedAt', 'elapsedMs'])
        && r.keys().hasAll(['playerId', 'date', 'game', 'score', 'won', 'checks', 'reveals', 'completedAt'])
        && r.playerId == request.auth.uid
        && r.date is string && r.date.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && league in ['general', 'nfl', 'mlb', 'nba', 'ncaaf']
        && r.game in ['player', 'ladder', 'cross', 'grid', 'drill']
        && (league == 'general' || r.game in ['player', 'ladder', 'cross'])
        && id == request.auth.uid + '_' + r.date + '_' + (league == 'general' ? '' : league + '_') + r.game
        && r.score is int && r.won is bool && r.won == (r.score > 0)
        && r.checks is int && r.checks >= 0 && r.checks <= 1000000
        && r.reveals is int && r.reveals >= 0 && r.reveals <= 121
        && (!('elapsedMs' in r) || (r.game == 'cross' && r.elapsedMs is int && r.elapsedMs >= 0 && r.elapsedMs <= 9007199254740991))
        && ((r.game == 'player' && r.score >= 0 && r.score <= 5 && r.checks == 0 && r.reveals == 0)
          || (r.game == 'ladder' && r.score >= 0 && r.score <= 15 && r.checks == 0 && r.reveals == 0)
          || (r.game == 'cross' && r.score == 1)
          || (r.game == 'grid' && r.score == 9 && r.reveals == 0)
          || (r.game == 'drill' && r.score >= 0 && r.score <= 500 && r.checks == 0 && r.reveals == 0))
        && r.completedAt == request.time && released(r.date, league)
        && field in get(path).data.puzzle;
    }
    match /owners/{uid} {
      // Bootstrap this document manually in the Firebase Console. A client
      // cannot grant itself owner access or edit the owner list.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      // A registered player can provision only their own immutable user role.
      // Publishing authority comes exclusively from the separate owners list.
      allow get: if owner() || (request.auth != null && request.auth.uid == uid);
      allow list: if owner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com']
        && request.resource.data.keys().hasOnly(['role', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'createdAt'])
        && request.resource.data.role == 'user' && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /dailyPuzzles/{date} {
      allow get: if owner() || (resource.data.published == true && resource.data.unlockAt <= request.time);
      allow list: if owner();
      allow create: if owner() && validPuzzle(date, 'general') && request.resource.data.revision == 1;
      allow update: if owner() && validPuzzle(date, 'general')
        && request.resource.data.revision == resource.data.revision + 1
        && (!(resource.data.published == true && resource.data.unlockAt <= request.time)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt', 'updatedBy', 'revision']));
      allow delete: if false;
    }
    match /leaguePuzzles/{league}/days/{date} {
      allow get: if owner() || (resource.data.published == true && resource.data.unlockAt <= request.time);
      allow list: if owner();
      allow create: if owner() && validPuzzle(date, league) && request.resource.data.revision == 1;
      allow update: if owner() && validPuzzle(date, league)
        && request.resource.data.revision == resource.data.revision + 1
        && (!(resource.data.published == true && resource.data.unlockAt <= request.time)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt', 'updatedBy', 'revision']));
      allow delete: if false;
    }
    match /dailyEditions/{date} {
      allow get: if owner() || resource.data.unlockAt <= request.time;
      allow list: if false;
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['date', 'published', 'unlockAt', 'updatedAt'])
        && request.resource.data.date == date && request.resource.data.updatedAt == request.time
        && request.resource.data.unlockAt is timestamp && request.resource.data.published is map
        && request.resource.data.published.keys().hasOnly(['general', 'nfl', 'mlb', 'nba', 'ncaaf'])
        && request.resource.data.published.get('general', false) is bool
        && request.resource.data.published.get('nfl', false) is bool
        && request.resource.data.published.get('mlb', false) is bool
        && request.resource.data.published.get('nba', false) is bool
        && request.resource.data.published.get('ncaaf', false) is bool;
      allow delete: if false;
    }
    // Canonical keys are used by rules. The public slate already contains the
    // game answers; this is a friendly trivia leaderboard, not prize security.
    match /drillKeys/{date} {
      allow get: if owner();
      allow list: if false;
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['answers', 'published', 'unlockAt'])
        && request.resource.data.answers is list && request.resource.data.answers.size() > 0 && request.resource.data.answers.size() <= 500
        && request.resource.data.answers.toSet().size() == request.resource.data.answers.size()
        && request.resource.data.published is bool && request.resource.data.unlockAt is timestamp
        && (!(resource != null && resource.data.published == true && resource.data.unlockAt <= request.time));
      allow delete: if false;
    }
    function registered(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    function drillOpen(date) {
      return released(date, 'general')
        && 'twoMinuteDrill' in get(/databases/$(database)/documents/dailyPuzzles/$(date)).data.puzzle
        && exists(/databases/$(database)/documents/drillKeys/$(date))
        && get(/databases/$(database)/documents/drillKeys/$(date)).data.published == true
        && get(/databases/$(database)/documents/drillKeys/$(date)).data.unlockAt <= request.time;
    }
    match /drillRuns/{date}/players/{uid} {
      allow get: if owner() || (request.auth != null && request.auth.uid == uid);
      allow list: if false;
      allow create: if registered(uid) && drillOpen(date)
        && request.resource.data.keys().hasOnly(['playerId', 'date', 'displayName', 'startedAt', 'found'])
        && request.resource.data.keys().hasAll(['playerId', 'date', 'displayName', 'startedAt', 'found'])
        && request.resource.data.playerId == uid && request.resource.data.date == date
        && nameOK(request.resource.data.displayName) && request.resource.data.startedAt == request.time
        && request.resource.data.found == [];
      allow update: if registered(uid) && drillOpen(date)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['found'])
        && request.time < resource.data.startedAt + duration.value(120, 's')
        && request.resource.data.found is list
        && request.resource.data.found.size() == resource.data.found.size() + 1
        && request.resource.data.found.toSet().size() == request.resource.data.found.size()
        && request.resource.data.found.hasAll(resource.data.found)
        && request.resource.data.found.hasOnly(get(/databases/$(database)/documents/drillKeys/$(date)).data.answers);
      allow delete: if false;
    }
    function rankedScore(date, uid) {
      let run = get(/databases/$(database)/documents/drillRuns/$(date)/players/$(uid)).data;
      let score = request.resource.data;
      return registered(uid) && drillOpen(date)
        && score.keys().hasOnly(['displayName', 'score', 'completedAt'])
        && score.keys().hasAll(['displayName', 'score', 'completedAt'])
        && score.displayName == run.displayName && score.score is int && score.score == run.found.size()
        && score.completedAt == request.time
        && (request.time >= run.startedAt + duration.value(120, 's')
          || run.found.size() == get(/databases/$(database)/documents/drillKeys/$(date)).data.answers.size());
    }
    match /drillLeaderboards/{date}/scores/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || drillOpen(date);
      allow list: if drillOpen(date) && request.query.limit <= 25;
      allow create: if rankedScore(date, uid);
      allow update, delete: if false;
    }
    match /results/{id} {
      // One immutable completion per guest, date, and game. No public score list.
      allow create: if validResult(id);
      allow get: if owner() || (request.auth != null && resource.data.playerId == request.auth.uid);
      allow list: if owner() || (request.auth != null
        && resource.data.playerId == request.auth.uid && request.query.limit <= 120);
      allow update, delete: if false;
    }
    function newSubmission(id) {
      let s = request.resource.data;
      let l = getAfter(/databases/$(database)/documents/submissionLimits/$(request.auth.uid)).data;
      return s.keys().hasOnly(['schemaVersion', 'game', 'proposedName', 'puzzleJson', 'submittedBy', 'createdAt', 'status', 'revision'])
        && s.keys().hasAll(['schemaVersion', 'game', 'proposedName', 'puzzleJson', 'submittedBy', 'createdAt', 'status', 'revision'])
        && s.schemaVersion == 1 && s.game in ['player', 'ladder', 'cross'] && nameOK(s.proposedName)
        && s.puzzleJson is string && s.puzzleJson.size() > 1 && s.puzzleJson.size() <= 50000
        && s.submittedBy == request.auth.uid && s.createdAt == request.time && s.status == 'pending' && s.revision == 1
        && l.lastSubmissionId == id && l.lastSubmittedAt == request.time;
    }
    function reviewOK() {
      let s = request.resource.data;
      return s.diff(resource.data).affectedKeys().hasOnly(['reviewedName', 'reviewedPuzzleJson', 'reviewedBy', 'reviewedAt', 'revision', 'status', 'publishedDates', 'publishedAssignments', 'publishedAt'])
        && s.status in ['pending', 'approved', 'rejected', 'published']
        && s.revision == resource.data.revision + 1 && s.reviewedBy == request.auth.uid && s.reviewedAt == request.time
        && (!('reviewedName' in s) || nameOK(s.reviewedName))
        && (!('reviewedPuzzleJson' in s) || (s.reviewedPuzzleJson is string && s.reviewedPuzzleJson.size() > 1 && s.reviewedPuzzleJson.size() <= 50000))
        && (!(s.status in ['approved', 'published']) || (nameOK(s.reviewedName) && s.reviewedPuzzleJson is string))
        && (!('publishedAssignments' in s) || (s.publishedAssignments is list && s.publishedAssignments.size() <= 30))
        && (!('publishedDates' in s) || (s.publishedDates is list && s.publishedDates.size() <= 30))
        && (!s.diff(resource.data).affectedKeys().hasAny(['publishedAt']) || s.publishedAt == request.time);
    }
    match /submissions/{id} {
      allow get, list: if owner();
      allow create: if request.auth != null && newSubmission(id);
      allow update: if owner() && reviewOK();
      allow delete: if false;
    }
    function limitShape(uid) {
      let l = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/submissions/$(l.lastSubmissionId)).data;
      return request.auth != null && request.auth.uid == uid
        && l.keys().hasOnly(['windowStartedAt', 'lastSubmittedAt', 'count', 'lastSubmissionId'])
        && l.keys().hasAll(['windowStartedAt', 'lastSubmittedAt', 'count', 'lastSubmissionId'])
        && l.windowStartedAt is timestamp && l.lastSubmittedAt == request.time && l.count is int && l.count > 0 && l.count <= 5
        && l.lastSubmissionId is string && l.lastSubmissionId.matches('[A-Za-z0-9_-]{1,128}')
        && !exists(/databases/$(database)/documents/submissions/$(l.lastSubmissionId))
        && s.submittedBy == uid && s.createdAt == request.time && s.status == 'pending';
    }
    match /submissionLimits/{uid} {
      allow get: if owner() || (request.auth != null && request.auth.uid == uid);
      allow list: if owner();
      allow create: if limitShape(uid) && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time;
      allow update: if limitShape(uid)
        && request.time >= resource.data.lastSubmittedAt + duration.value(60, 's')
        && ((request.time < resource.data.windowStartedAt + duration.value(1, 'd')
          && request.resource.data.windowStartedAt == resource.data.windowStartedAt && request.resource.data.count == resource.data.count + 1)
          || (request.time >= resource.data.windowStartedAt + duration.value(1, 'd')
            && request.resource.data.windowStartedAt == request.time && request.resource.data.count == 1));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
